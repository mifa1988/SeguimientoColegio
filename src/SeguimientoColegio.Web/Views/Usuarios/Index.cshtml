@model UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Subtitle"] = "Acceso por correo y contrasena con control por roles.";
}

<section class="table-card">
    <div class="toolbar">
        <div>
            <h2>Usuarios</h2>
            <p class="text-soft mb-0">Administrador, Editor y Consulta.</p>
        </div>
        <a asp-action="Create" class="btn-app btn-app--primary">Nuevo usuario</a>
    </div>
    <div class="table-card__body">
        <table class="app-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Ultimo login</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Nombres @(item.Apellidos ?? string.Empty)</strong>
                            <span class="text-soft">@item.Correo</span>
                        </td>
                        <td>@item.Rol</td>
                        <td>@(item.UltimoLogin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td>@(item.Activo ? "Si" : "No")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-app btn-app--ghost btn-app--compact">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
