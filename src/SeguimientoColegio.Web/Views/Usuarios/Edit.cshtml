@model UsuarioFormPageViewModel
@{
    ViewData["Title"] = "Editar usuario";
    ViewData["Subtitle"] = "Actualiza datos, rol y estado del usuario.";
}

<section class="page-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <partial name="_Form" model="Model" />
        <div class="helper-text mt-2">Deja la contrasena en blanco si no deseas cambiarla.</div>
        <div class="form-actions mt-3">
            <button type="submit" class="btn-app btn-app--primary">Guardar cambios</button>
            <a asp-action="Index" class="btn-app btn-app--ghost">Volver</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
