@model NinosIndexViewModel
@{
    ViewData["Title"] = "Ninos";
    ViewData["Subtitle"] = "Administracion de ninos y contexto principal de trabajo.";
}

<section class="table-card">
    <div class="toolbar">
        <div>
            <h2>Ninos</h2>
            <p class="text-soft mb-0">Agrega y mantiene a Daniela, Bruno y futuros perfiles.</p>
        </div>
        <a asp-action="Create" class="btn-app btn-app--primary">Nuevo nino</a>
    </div>
    <div class="table-card__body">
        <table class="app-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Alias</th>
                    <th>Nacimiento</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.Nombres @item.Apellidos</strong></td>
                        <td>@(item.Alias ?? "-")</td>
                        <td>@(item.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(item.Activo ? "Si" : "No")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-app btn-app--ghost btn-app--compact">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
