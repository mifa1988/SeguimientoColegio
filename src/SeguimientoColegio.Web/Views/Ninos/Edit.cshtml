@model NinoFormPageViewModel
@{
    ViewData["Title"] = "Editar nino";
    ViewData["Subtitle"] = "Actualiza el perfil del nino.";
}

<section class="page-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <partial name="_Form" model="Model.Form" />
        <div class="form-actions mt-3">
            <button type="submit" class="btn-app btn-app--primary">Guardar cambios</button>
            <a asp-action="Index" class="btn-app btn-app--ghost">Volver</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
